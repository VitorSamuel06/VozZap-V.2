# =====================================================
# SUPABASE - Conexão com Banco de Dados e Auth
# =====================================================

# URL do projeto Supabase
VITE_SUPABASE_URL=https://gzkpfllfewgievkhwryd.supabase.co

# Chave anonima do Supabase (para o cliente)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd6a3BmbGxmZXdnaWV2a2h3cnlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0OTY2NDcsImV4cCI6MjA5ODA3MjY0N30.nzgfBeNSdZZIv8W-vMtwOHRXtgGyUgFG_sPo6b5iwhY

# =====================================================
# VARIÁVEIS DE APLICAÇÃO
# =====================================================

# Modo de ambiente
VITE_APP_ENV=development

# Versão da aplicação
VITE_APP_VERSION=1.0.0

# URL base da aplicação
VITE_APP_URL=http://localhost:5173

# =====================================================
# CONFIGURAÇÕES DE AUDIO
# =====================================================

# Qualidade padrão do áudio gravado (em kbps)
VITE_AUDIO_BITRATE=128

# Duração máxima de gravação em segundos (30 minutos)
VITE_MAX_RECORDING_DURATION=1800

# Tamanho máximo de upload de áudio em MB
VITE_MAX_AUDIO_SIZE=50

# =====================================================
# CONFIGURAÇÕES DE STORAGE
# =====================================================

# Bucket do Supabase para áudios
VITE_STORAGE_BUCKET_AUDIOS=audios

# Bucket do Supabase para avatares
VITE_STORAGE_BUCKET_AVATARS=avatars

# Bucket do Supabase para covers
VITE_STORAGE_BUCKET_COVERS=covers

# Caminho público do Supabase Storage
VITE_SUPABASE_STORAGE_URL=https://xkzkcgyegjswdjlmanzy.supabase.co/storage/v1/object/public

# =====================================================
# PAGINAÇÃO E LIMITES
# =====================================================

# Itens por página no feed
VITE_ITEMS_PER_PAGE=10

# Itens por página em listas de usuários
VITE_USERS_PER_PAGE=20

# Limite de caracteres no bio
VITE_BIO_CHAR_LIMIT=160

# Limite de caracteres no título da publicação
VITE_TITLE_CHAR_LIMIT=200

# Limite de caracteres no comentário
VITE_COMMENT_CHAR_LIMIT=500

# =====================================================
# CACHE E REQUISIÇÕES
# =====================================================

# TTL do cache em minutos
VITE_CACHE_TTL=15

# Timeout de requisição em ms
VITE_REQUEST_TIMEOUT=30000

# Número de tentativas de retry
VITE_RETRY_ATTEMPTS=3

# =====================================================
# ANALYTICS (Opcional)
# =====================================================

# ID do Google Analytics (se usar)
# VITE_GA_ID=UA-XXXXXXXXX-X

# =====================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =====================================================

# CORS - Origins permitidos (separados por vírgula)
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting - requisições por minuto
VITE_RATE_LIMIT=60

# =====================================================
# NOTIFICAÇÕES (Opcional)
# =====================================================

# URL do servidor de notificações (se usar)
# VITE_NOTIFICATION_SERVER=ws://localhost:8080

# =====================================================
# MODO DEBUG
# =====================================================

# Ativar logs detalhados
VITE_DEBUG=false

# =====================================================
# NOTAS IMPORTANTES
# =====================================================
# 
# 1. NÃO compartilhe este arquivo em repositórios públicos
# 2. Adicione .env ao .gitignore
# 3. Use .env.example para variáveis públicas
# 4. Nunca coloque chaves secretas aqui em produção
# 5. Para produção, configure variáveis no dashboard do Supabase
#
# COMO OBTER AS CHAVES DO SUPABASE:
# 1. Acesse https://app.supabase.com
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie:
#    - Project URL → VITE_SUPABASE_URL
#    - anon (public) key → VITE_SUPABASE_ANON_KEY
#
# =====================================================
