# =====================================================
# VOZZAP - Variáveis de Ambiente (EXEMPLO)
# =====================================================
# Este arquivo documenta as variáveis necessárias.
# Copie para .env e preencha com seus valores reais.
# =====================================================

# SUPABASE
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# APLICAÇÃO
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_URL=http://localhost:5173

# STORAGE
VITE_STORAGE_BUCKET_AUDIOS=audios
VITE_STORAGE_BUCKET_AVATARS=avatars
VITE_STORAGE_BUCKET_COVERS=covers
VITE_SUPABASE_STORAGE_URL=https://seu-projeto.supabase.co/storage/v1/object/public

# AUDIO
VITE_AUDIO_BITRATE=128
VITE_MAX_RECORDING_DURATION=1800
VITE_MAX_AUDIO_SIZE=50

# PAGINAÇÃO
VITE_ITEMS_PER_PAGE=10
VITE_USERS_PER_PAGE=20
VITE_BIO_CHAR_LIMIT=160
VITE_TITLE_CHAR_LIMIT=200
VITE_COMMENT_CHAR_LIMIT=500

# CACHE
VITE_CACHE_TTL=15
VITE_REQUEST_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# SEGURANÇA
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_RATE_LIMIT=60

# DEBUG
VITE_DEBUG=false
